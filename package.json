{
  "name": "desktop-mascot-hakomaru",
  "productName": "ハコまる",
  "version": "1.0.0",
  "description": "デスクトップを歩き回るマスコット「ハコまる」",
  "author": "syoney",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.syoney.hakomaru",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Hakomaru-Setup-${version}.${ext}"
    },
    "nsis": {
      "shortcutName": "ハコまる"
    }
  }
}
